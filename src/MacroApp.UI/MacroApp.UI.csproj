<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MacroRecorder</AssemblyName>
    <Version>1.0.0</Version>
    <Product>MacroRecorder</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroApp.Core\MacroApp.Core.csproj" />
    <ProjectReference Include="..\MacroApp.NativeInterop\MacroApp.NativeInterop.csproj" />
    <ProjectReference Include="..\MacroApp.Scripting\MacroApp.Scripting.csproj" />
    <ProjectReference Include="..\MacroApp.ImageMatch\MacroApp.ImageMatch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\MacroScript.xshd" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
