<Window x:Class="MacroApp.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="MacroRecorder"
        Width="1240" Height="780"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EmergencyStopCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveMacroCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewMacroCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Status bar turns red while recording and blue while playing -->
        <Style x:Key="StatusBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StatusPlayingBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusPlayingBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextOnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCountingDown}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StatusRecordingBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusRecordingBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextOnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StatusRecordingBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusRecordingBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PauseButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Tag" Value="&#xE769;" />
            <Setter Property="Content" Value="Pause" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Tag" Value="&#xE768;" />
                    <Setter Property="Content" Value="Resume" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0,8,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Command bar ═══════════════════════════════════════ -->
        <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Speed" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="78" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SelectedSpeed}"
                              ItemStringFormat="{}{0:0.##}×" ToolTip="Playback speed. Scales every delay in the macro." />

                    <Rectangle Style="{StaticResource BarSeparator}" Margin="10,0,6,0" />

                    <Button Style="{StaticResource IconButton}" Tag="&#xE8B5;" Click="Import_Click" ToolTip="Import .mcr files" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xEDE1;" Click="Export_Click" ToolTip="Export the selected macro" />
                    <Button Style="{StaticResource IconButton}" Tag="&#xE713;" Click="Settings_Click" ToolTip="Settings" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CommandButton}" Command="{Binding ToggleRecordCommand}"
                            ToolTip="Start or stop recording. The hotkeys are shown in the status bar.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource RecordBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Opacity" Value="{Binding RecordingIndicatorVisible, Converter={StaticResource BoolToOpacity}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Record" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="Stop recording" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCountingDown}" Value="True">
                                                <Setter Property="Text" Value="Cancel" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CommandButton}" Tag="&#xE768;" Content="Play"
                            Command="{Binding PlayCommand}" ToolTip="Play the selected macro" />
                    <Button Style="{StaticResource PauseButton}" Command="{Binding PausePlaybackCommand}" />
                    <Button Style="{StaticResource CommandButton}" Tag="&#xE893;" Content="Step"
                            Command="{Binding StepThroughCommand}"
                            ToolTip="Run one line at a time. Press again for the next line, or Resume to carry on." />
                    <Button Style="{StaticResource CommandButton}" Tag="&#xE71A;" Content="Stop"
                            Command="{Binding StopAllCommand}" ToolTip="Stop recording or playback" />

                    <Rectangle Style="{StaticResource BarSeparator}" />

                    <Button Style="{StaticResource CommandButton}" Tag="&#xE710;" Content="New"
                            Command="{Binding NewMacroCommand}" ToolTip="New macro (Ctrl+N)" />
                    <Button Style="{StaticResource CommandButton}" Tag="&#xE74E;" Content="Save"
                            Command="{Binding SaveMacroCommand}" ToolTip="Save (Ctrl+S)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Main area ═════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="270" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ── Macro list ─────────────────────────────────── -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <TextBlock Text="Macros" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </Border>

                <TextBox DockPanel.Dock="Top" Margin="10,10,10,6" Tag="Search"
                         Text="{Binding MacroList.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CommandButton}" Tag="&#xE8C8;" Content="Duplicate" Padding="8,0"
                                Command="{Binding MacroList.DuplicateSelectedCommand}" />
                        <Button Style="{StaticResource CommandButton}" Tag="&#xE74D;" Content="Delete" Padding="8,0"
                                Click="Delete_Click" />
                    </StackPanel>
                </Border>

                <Grid>
                    <ListBox ItemsSource="{Binding MacroList.FilteredMacros}"
                             SelectedItem="{Binding MacroList.SelectedMacro, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource HintText}" TextAlignment="Center" Margin="20,24,20,0"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Text="No macros to show. Press Record, or New to write one."
                               Visibility="{Binding MacroList.FilteredMacros.Count, Converter={StaticResource ZeroToVisible}}" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" />

            <!-- ── Script editor ──────────────────────────────── -->
            <DockPanel Grid.Column="2" Background="{StaticResource EditorBrush}">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Background="{StaticResource WindowBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Tag="&#xE722;" Content="Capture image"
                                Padding="8,0" Click="CaptureImage_Click"
                                ToolTip="Drag a box around something on screen. It's saved next to the macro and a ClickImage line is added." />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Editor.MacroName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Unsaved" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="10,1,0,0"
                                       Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Problems line under the editor -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource WindowBrush}" Padding="14,6" MaxHeight="96">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor.ValidationMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.HasErrors}" Value="True">
                                            <Setter Property="Text" Value="&#xE783;" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Editor.ValidationMessage}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editor.HasErrors}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid>
                    <avalonedit:TextEditor x:Name="ScriptEditor"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="13"
                                           Background="{StaticResource EditorBrush}"
                                           Foreground="{StaticResource TextBrush}"
                                           LineNumbersForeground="{StaticResource TextMutedBrush}"
                                           ShowLineNumbers="True"
                                           WordWrap="False"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           Padding="6,4,0,0" />

                    <!-- Shown until a macro is selected -->
                    <Border Background="{StaticResource EditorBrush}"
                            Visibility="{Binding SelectedMacro, Converter={StaticResource NullToVisible}}">
                        <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" FontSize="13"
                                   Text="Select a macro on the left, or press Record to make one." />
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Style="{StaticResource Splitter}" />

            <!-- ── Properties and recorded events ─────────────── -->
            <DockPanel Grid.Column="4">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <TextBlock Text="Properties" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="14,0,14,16">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editor.MacroName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editor.MacroDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editor.MacroCategory, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editor.RepeatCount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Number of times to play it. -1 keeps going until you stop it."
                               Style="{StaticResource HintText}" Margin="0,4,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" BorderThickness="0,1,0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding EventCount}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Recorded events" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Grid>
                    <ListBox ItemsSource="{Binding LiveEvents}" ItemContainerStyle="{StaticResource PlainListItem}"
                             Padding="0,6" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EventToDisplay}}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource HintText}" Margin="14,12,14,0" VerticalAlignment="Top"
                               Text="Events show up here as you record."
                               Visibility="{Binding LiveEvents.Count, Converter={StaticResource ZeroToVisible}}" />
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ═══ Status bar ════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource StatusBar}" Padding="12,0" Height="26">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HotkeyHint}" FontSize="12" Opacity="0.75" />
                    <TextBlock Text="{Binding AppState, Converter={StaticResource StateLabel}}" FontSize="12"
                               FontWeight="SemiBold" Margin="16,0,0,0" MinWidth="64" TextAlignment="Right" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
