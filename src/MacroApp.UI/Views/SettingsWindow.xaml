<Window x:Class="MacroApp.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Button row -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,14">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Reset to defaults" Click="Defaults_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Save" Margin="8,0,0,0"
                        IsDefault="True" Click="Save_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource StandardButton}" Content="Cancel" IsCancel="True" />
            </DockPanel>
        </Border>

        <StackPanel Margin="20,0,20,16">
            <TextBlock Text="Hotkeys" Style="{StaticResource Group}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                       Text="Click a box and press the key or combination you want. These work from any app." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Start / stop recording" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RecordBox" Margin="0,3" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

                <TextBlock Grid.Row="1" Text="Start / stop playback" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PlayBox" Margin="0,3" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

                <TextBlock Grid.Row="2" Text="Stop everything" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="StopBox" Margin="0,3" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

                <TextBlock Grid.Row="3" Text="Emergency stop" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="EmergencyBox" Margin="0,3" PreviewKeyDown="SingleKeyBox_PreviewKeyDown"
                         ToolTip="A single key, no modifiers. Stops playback from anywhere." />
            </Grid>

            <TextBlock Text="Recording" Style="{StaticResource Group}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Countdown" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="CountdownBox" Margin="0,3" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="seconds" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0" />

                <TextBlock Grid.Row="1" Text="Ignore mouse moves under" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ThresholdBox" Margin="0,3" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="pixels" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="General" Style="{StaticResource Group}" />
            <CheckBox x:Name="StartupBox" Content="Start MacroRecorder when I sign in to Windows" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap"
                       Margin="0,16,0,0" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
