<Window x:Class="MacroApp.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgSecondaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,8,18,16">
        <TextBlock Text="HOTKEYS" Style="{StaticResource Section}" />
        <TextBlock Text="Click a box and press the key combination you want." FontSize="11"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Start / stop recording" Style="{StaticResource Label}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RecordBox" Margin="0,3" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

            <TextBlock Grid.Row="1" Text="Start / stop playback" Style="{StaticResource Label}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PlayBox" Margin="0,3" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

            <TextBlock Grid.Row="2" Text="Stop everything" Style="{StaticResource Label}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="StopBox" Margin="0,3" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

            <TextBlock Grid.Row="3" Text="Emergency stop key" Style="{StaticResource Label}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="EmergencyBox" Margin="0,3" PreviewKeyDown="SingleKeyBox_PreviewKeyDown"
                     ToolTip="A single key, no modifiers. Works from any app while a macro is playing." />
        </Grid>

        <TextBlock Text="RECORDING" Style="{StaticResource Section}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Countdown (seconds)" Style="{StaticResource Label}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CountdownBox" Margin="0,3" />

            <TextBlock Grid.Row="1" Text="Ignore mouse moves under (px)" Style="{StaticResource Label}" TextWrapping="Wrap" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ThresholdBox" Margin="0,3" />
        </Grid>

        <TextBlock Text="GENERAL" Style="{StaticResource Section}" />
        <CheckBox x:Name="StartupBox" Content="Start MacroRecorder when I sign in to Windows"
                  Foreground="{StaticResource TextPrimaryBrush}" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentRedBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="12,6" Click="Defaults_Click">
                <TextBlock Text="Reset to defaults" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="6,0,0,0"
                    IsDefault="True" Click="Save_Click">
                <TextBlock Text="Save" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,6" IsCancel="True">
                <TextBlock Text="Cancel" />
            </Button>
        </DockPanel>
    </StackPanel>
</Window>
