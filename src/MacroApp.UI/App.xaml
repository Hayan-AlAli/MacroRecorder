<Application x:Class="MacroApp.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MacroApp.UI.Views"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DarkTheme.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <views:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <views:NullToVisibleConverter x:Key="NullToVisible" />
            <views:ZeroToVisibleConverter x:Key="ZeroToVisible" />
            <views:StateLabelConverter x:Key="StateLabel" />
            <views:EventToDisplayConverter x:Key="EventToDisplay" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
