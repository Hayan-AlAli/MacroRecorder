<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Neutral dark palette, close to Windows 11's own dark mode. One accent colour;
        red is reserved for recording and errors.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="EditorBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ControlBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#323232" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="PopupBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2E2E2E" />

    <!-- Subtle overlays for hover / press / selection on transparent controls -->
    <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#14FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#707070" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accent and states -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B8EEA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C99EE" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3280D6" />
    <SolidColorBrush x:Key="RecordBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F28B82" />
    <SolidColorBrush x:Key="StatusRecordingBrush" Color="#9E2A2B" />
    <SolidColorBrush x:Key="StatusPlayingBrush" Color="#1F5F99" />

    <!-- The corner square between two scrollbars uses this system brush -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1A1A" />

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- Segoe Fluent Icons ships with Windows 11, Segoe MDL2 Assets with Windows 10; same code points -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
